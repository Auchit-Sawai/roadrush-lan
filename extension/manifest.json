{
  "manifest_version": 3,
  "name": "RoadRush LAN",
  "version": "0.1.0",
  "description": "Offline low-poly arcade motorcycle racing with LAN multiplayer for up to eight riders.",
  "minimum_chrome_version": "110",
  "key": "",
  "permissions": ["storage"],
  "action": {
    "default_title": "RoadRush LAN",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
