{
  "name": "roadrush-lan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RoadRush LAN - low-poly arcade motorcycle racing with offline play and local-network multiplayer.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "server": "node server/src/index.js",
    "build:server": "node scripts/build-server.mjs",
    "icons": "node scripts/make-icons.mjs",
    "test": "node --test \"tests/*.test.js\"",
    "smoke": "node scripts/browser-smoke.mjs",
    "package:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1",
    "build:pages": "vite build --config vite.pages.config.js"
  },
  "dependencies": {
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
